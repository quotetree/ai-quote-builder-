# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (required for Scope + Plan chat)
OPENAI_API_KEY=sk-your-openai-key

# Tavily (optional — Copilot web discovery/search)
TAVILY_API_KEY=tvly-your-tavily-key

# Firecrawl (optional — Copilot read-page extraction; not used for search)
FIRECRAWL_API_KEY=fc-your-firecrawl-key

# Document intelligence (Phase 1)
ENABLE_CHUNK_EMBEDDINGS=false
HYBRID_SEMANTIC_WEIGHT=0.5
HYBRID_KEYWORD_WEIGHT=0.3
HYBRID_METADATA_WEIGHT=0.2
SEMANTIC_MATCH_COUNT=50
SEMANTIC_MATCH_THRESHOLD=0.25

# OCR fallback for scanned PDF pages (optional)
OCR_ENABLED=false
OCR_PROVIDER=textract
OCR_MAX_PAGES_PER_DOC=200
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SHARE_BASE_URL=https://quotetree.ai
